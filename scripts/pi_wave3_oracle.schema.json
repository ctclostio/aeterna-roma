{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/pi-wave3/oracle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["worker_id", "stage", "tests", "mutants", "blockers"],
  "properties": {
    "worker_id": { "type": "string", "pattern": "^O[0-9]{2}$" },
    "stage": { "const": "O" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "requirement_ids", "description", "procedure", "expected", "mutant_ids"],
        "properties": {
          "test_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "description": { "type": "string", "minLength": 1 },
          "procedure": { "type": "string", "minLength": 1 },
          "expected": { "type": "string", "minLength": 1 },
          "mutant_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "mutants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mutant_id", "critical", "description", "expected_killer_ids"],
        "properties": {
          "mutant_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
          "critical": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "expected_killer_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
