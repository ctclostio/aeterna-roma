{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/pi-wave3/config.schema.json",
  "title": "Pi wave 3 orchestration configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "prompt_preamble",
    "stage_order",
    "stages",
    "workers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "model": {
      "const": "openrouter/stealth/ox-alpha"
    },
    "launch_stagger_milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "milestone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "prompt_preamble": {
      "type": "string",
      "maxLength": 32768
    },
    "allowed_requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$"
      }
    },
    "semantic_gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/semantic_gate"
      }
    },
    "stage_order": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": [
        { "const": "E" },
        { "const": "O" },
        { "const": "I" },
        { "const": "R" },
        { "const": "G" }
      ],
      "additionalItems": false
    },
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/definitions/stage"
      }
    },
    "workers": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/worker"
      }
    }
  },
  "definitions": {
    "stage_id": {
      "type": "string",
      "enum": ["E", "O", "I", "R", "G"]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "timeout_seconds",
        "max_tool_calls",
        "max_output_bytes"
      ],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 7200
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "artifact_checkpoint_tool_calls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "At least one required workspace artifact must be safely observed by the supervisor no later than this many completed tool results."
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 128,
          "maximum": 16777216
        }
      }
    },
    "required_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "format", "schema", "max_bytes"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "source": {
          "type": "string",
          "enum": ["report", "workspace"]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "format": {
          "type": "string",
          "enum": ["json", "text", "file"]
        },
        "schema": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 240
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "source": { "const": "workspace" } }
          },
          "then": { "required": ["path"] }
        },
        {
          "if": {
            "properties": { "schema": { "type": "string" } }
          },
          "then": {
            "properties": { "format": { "const": "json" } }
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "depends_on", "worker_count"],
      "properties": {
        "id": { "$ref": "#/definitions/stage_id" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/stage_id" }
        },
        "worker_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    "semantic_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "script", "script_sha256", "workspace_root"],
      "properties": {
        "stage": { "$ref": "#/definitions/stage_id" },
        "script": {
          "type": "string",
          "minLength": 12,
          "maxLength": 240,
          "pattern": "^scripts(?:/[A-Za-z0-9][A-Za-z0-9._-]*)+\\.py$"
        },
        "script_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workspace_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stage",
        "role",
        "task",
        "tools",
        "thinking",
        "budget",
        "writable_dir",
        "context_files",
        "review_targets",
        "required_outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[EOIRG][0-9]{2}$"
        },
        "stage": { "$ref": "#/definitions/stage_id" },
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,63}$"
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          }
        },
        "thinking": {
          "type": "string",
          "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
        },
        "budget": { "$ref": "#/definitions/budget" },
        "writable_dir": {
          "type": ["string", "null"],
          "maxLength": 160
        },
        "context_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "review_targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^I[0-9]{2}$"
          }
        },
        "expected_workspace_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required_outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/definitions/required_output" }
        }
      }
    }
  }
}
