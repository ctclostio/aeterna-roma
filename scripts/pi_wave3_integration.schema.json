{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/pi-wave3/integration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker_id",
    "stage",
    "milestone",
    "requirement_ids",
    "selected_components",
    "files",
    "tests",
    "unresolved_decisions"
  ],
  "properties": {
    "worker_id": { "type": "string", "pattern": "^G[0-9]{2}$" },
    "stage": { "const": "G" },
    "milestone": { "type": "string", "minLength": 1 },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "selected_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["worker_id", "artifact_sha256"],
        "properties": {
          "worker_id": { "type": "string", "pattern": "^[EOIR][0-9]{2}$" },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byte_count"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "byte_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
