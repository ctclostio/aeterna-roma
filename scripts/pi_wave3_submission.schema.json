{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/pi-wave3/submission.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["worker_id", "stage", "milestone", "files", "requirement_ids", "tests", "unresolved_decisions"],
  "properties": {
    "worker_id": { "type": "string", "pattern": "^I[0-9]{2}$" },
    "stage": { "const": "I" },
    "milestone": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/file" }
    },
    "requirement_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byte_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
