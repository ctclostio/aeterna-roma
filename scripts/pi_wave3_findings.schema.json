{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/pi-wave3/findings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["worker_id", "stage", "reviews"],
  "properties": {
    "worker_id": { "type": "string", "pattern": "^R[0-9]{2}$" },
    "stage": { "const": "R" },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "candidate_sha256", "verdict", "tests_run", "findings"],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^I[0-9]{2}$" },
          "candidate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "verdict": { "type": "string", "enum": ["pass", "fail", "blocked"] },
          "tests_run": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1 }
          },
          "findings": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "finding_id",
                "severity",
                "requirement_id",
                "description",
                "reproducer",
                "known_good_expected",
                "candidate_expected"
              ],
              "properties": {
                "finding_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
                "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
                "requirement_id": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "reproducer": { "type": "string", "minLength": 1 },
                "known_good_expected": { "type": "string", "minLength": 1 },
                "candidate_expected": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
