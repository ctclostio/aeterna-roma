{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://local.invalid/pi-wave3/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["worker_id", "stage", "conclusion", "claims", "blockers"],
  "properties": {
    "worker_id": { "type": "string", "pattern": "^E[0-9]{2}$" },
    "stage": { "const": "E" },
    "conclusion": { "type": "string", "minLength": 1 },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "kind",
          "value",
          "source_path",
          "source_sha256",
          "locator",
          "extractor_command",
          "inference"
        ],
        "properties": {
          "fact_id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
          "kind": { "type": "string", "minLength": 1 },
          "value": {},
          "source_path": { "type": "string", "minLength": 1 },
          "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "locator": { "type": "string", "minLength": 1 },
          "extractor_command": { "type": "string", "minLength": 1 },
          "inference": { "type": "boolean" }
        }
      }
    },
    "blockers": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
